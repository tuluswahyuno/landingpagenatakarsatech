---
/**
 * Mockup aplikasi dari HTML/CSS murni (tanpa gambar) — sangat ringan.
 * Ganti dengan screenshot asli lewat field `images` di portofolio bila sudah ada.
 */
interface Props { variant?: 'dashboard' | 'kasir' | 'mobile'; accent?: string; title?: string; class?: string }
const { variant = 'dashboard', accent = '#6366f1', title = 'Dashboard', class: cls = '' } = Astro.props;
const bars = [38, 55, 47, 70, 62, 84, 76, 92, 68, 88, 79, 96];
---
{variant === 'mobile' ? (
  <div class:list={['relative mx-auto w-[210px] rounded-[2.2rem] border border-white/15 bg-ink-950 p-2 shadow-2xl shadow-black/60', cls]} style={`--a:${accent}`} aria-hidden="true">
    <div class="overflow-hidden rounded-[1.7rem] bg-ink-800">
      <div class="flex items-center justify-between px-4 pt-3 pb-2 text-[9px] text-mist"><span>09.41</span><span class="h-3 w-14 rounded-full bg-ink-950"></span><span>100%</span></div>
      <div class="px-4 pb-3">
        <div class="text-[10px] text-mist">Halo, Sales 07</div>
        <div class="mt-0.5 text-sm font-semibold text-snow">{title}</div>
        <div class="mt-3 rounded-2xl p-3 text-white" style="background:linear-gradient(135deg,var(--a),color-mix(in oklab,var(--a) 50%,#0a0a0f))">
          <div class="text-[9px] opacity-80">Pesanan hari ini</div>
          <div class="mt-1 text-xl font-bold">Rp12,4 jt</div>
          <div class="mt-2 flex gap-1">{[60, 80, 45, 90, 70, 100, 85].map((h) => <span class="w-full rounded-sm bg-white/40" style={`height:${h * 0.22}px;align-self:flex-end`}></span>)}</div>
        </div>
        <div class="mt-3 space-y-2">
          {['Toko Sinar Jaya', 'UD Makmur', 'Toko Berkah'].map((n, i) => (
            <div class="flex items-center gap-2 rounded-xl bg-white/[0.04] p-2">
              <span class="grid h-7 w-7 place-items-center rounded-lg text-[10px] font-bold" style={`background:color-mix(in oklab,var(--a) 25%,transparent);color:var(--a)`}>{n[0]}</span>
              <div class="flex-1"><div class="text-[10px] font-medium text-snow">{n}</div><div class="text-[8px] text-mist">{12 + i * 7} item · terkirim</div></div>
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
) : variant === 'kasir' ? (
  <div class:list={['overflow-hidden rounded-2xl border border-white/10 bg-ink-850 shadow-2xl shadow-black/50', cls]} style={`--a:${accent}`} aria-hidden="true">
    <div class="flex items-center gap-1.5 border-b border-white/5 px-3 py-2"><span class="h-2 w-2 rounded-full bg-red-400/70"></span><span class="h-2 w-2 rounded-full bg-amber-400/70"></span><span class="h-2 w-2 rounded-full bg-emerald-400/70"></span><span class="ml-2 text-[10px] text-mist">{title}</span></div>
    <div class="grid grid-cols-5 gap-2 p-3">
      <div class="col-span-3 grid grid-cols-3 gap-2">
        {['Semen 50kg', 'Cat 5L', 'Paku 1kg', 'Pipa 3m', 'Keramik', 'Kabel 10m'].map((p, i) => (
          <div class="rounded-xl bg-white/[0.04] p-2">
            <div class="mb-1.5 h-8 rounded-lg" style={`background:color-mix(in oklab,var(--a) ${18 + i * 6}%,transparent)`}></div>
            <div class="truncate text-[9px] text-snow">{p}</div>
            <div class="text-[8px] text-mist">Rp{(i + 2) * 12}.000</div>
          </div>
        ))}
      </div>
      <div class="col-span-2 flex flex-col rounded-xl bg-white/[0.04] p-2">
        <div class="text-[9px] font-semibold text-snow">Keranjang</div>
        {['Semen 50kg ×4', 'Cat 5L ×1', 'Paku 1kg ×2'].map((l) => <div class="mt-1.5 flex justify-between text-[8px] text-mist"><span>{l}</span><span>✓</span></div>)}
        <div class="mt-auto pt-2 text-[8px] text-mist">Total</div>
        <div class="text-sm font-bold text-snow">Rp312.000</div>
        <div class="mt-1.5 rounded-lg py-1 text-center text-[9px] font-semibold text-ink-950" style="background:var(--a)">Bayar</div>
      </div>
    </div>
  </div>
) : (
  <div class:list={['overflow-hidden rounded-2xl border border-white/10 bg-ink-850 shadow-2xl shadow-black/50', cls]} style={`--a:${accent}`} aria-hidden="true">
    <div class="flex items-center gap-1.5 border-b border-white/5 px-3 py-2"><span class="h-2 w-2 rounded-full bg-red-400/70"></span><span class="h-2 w-2 rounded-full bg-amber-400/70"></span><span class="h-2 w-2 rounded-full bg-emerald-400/70"></span><span class="ml-2 text-[10px] text-mist">{title}</span></div>
    <div class="flex">
      <div class="hidden w-24 shrink-0 space-y-1.5 border-r border-white/5 p-2 sm:block">
        {['Ringkasan', 'Penjualan', 'Stok', 'Pelanggan', 'Laporan'].map((m, i) => <div class:list={['rounded-md px-2 py-1 text-[9px]', i === 0 ? 'text-snow' : 'text-mist']} style={i === 0 ? 'background:color-mix(in oklab,var(--a) 22%,transparent)' : ''}>{m}</div>)}
      </div>
      <div class="flex-1 p-3">
        <div class="grid grid-cols-3 gap-2">
          {[['Omzet', 'Rp84,2 jt', '+12%'], ['Transaksi', '1.284', '+8%'], ['Stok kritis', '6 item', '']].map(([l, v, d]) => (
            <div class="rounded-xl bg-white/[0.04] p-2">
              <div class="text-[8px] text-mist">{l}</div>
              <div class="text-xs font-bold text-snow">{v}</div>
              {d && <div class="text-[8px] text-emerald-400">{d}</div>}
            </div>
          ))}
        </div>
        <div class="mt-2 rounded-xl bg-white/[0.04] p-2">
          <div class="flex items-end gap-1" style="height:64px">
            {bars.map((h, i) => <span class="w-full rounded-t-sm" style={`height:${h}%;background:${i === bars.length - 1 ? 'var(--a)' : 'color-mix(in oklab,var(--a) 45%,transparent)'}`}></span>)}
          </div>
        </div>
        <div class="mt-2 space-y-1">
          {['INV-2041 · Lunas', 'INV-2040 · Dikirim', 'INV-2039 · Lunas'].map((r) => <div class="flex justify-between rounded-md bg-white/[0.03] px-2 py-1 text-[8px] text-mist"><span>{r}</span><span class="text-snow">Rp{(r.length * 113).toLocaleString('id-ID')}.000</span></div>)}
        </div>
      </div>
    </div>
  </div>
)}
