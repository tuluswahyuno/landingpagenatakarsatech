---
import Icon from './Icon.astro';
import { processSteps } from '../data/site';
---
<section id="proses" class="section">
  <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <span class="eyebrow" data-reveal>Proses kerja</span>
      <h2 class="h-section" data-reveal style="--d:1">Jelas dari hari pertama <span class="text-gradient">sampai setelah rilis.</span></h2>
      <p class="lead" data-reveal style="--d:2">Anda selalu tahu apa yang sedang dikerjakan, kapan selesai, dan berapa biayanya. Tanpa kejutan.</p>
    </div>
    <div id="timeline" class="relative pl-12">
      <div class="absolute top-2 bottom-2 left-[19px] w-px bg-white/10" aria-hidden="true"></div>
      <div id="timeline-fill" class="absolute top-2 left-[19px] w-px origin-top bg-gradient-to-b from-brand-400 via-violet to-aqua" style="height:calc(100% - 1rem);transform:scaleY(var(--p,0))" aria-hidden="true"></div>
      <ol class="space-y-6">
      {processSteps.map((s, i) => (
        <li class="step relative" data-reveal>
          <span class="step-dot absolute top-5 -left-12 grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-ink-900 font-display text-sm font-bold text-mist transition duration-500">{i + 1}</span>
          <div class="card p-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-lg font-semibold">{s.title}</h3>
              <span class="chip"><Icon name="clock" size={12} class="mr-1" />{s.time}</span>
            </div>
            <p class="mt-2 text-sm text-mist">{s.get}</p>
          </div>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .step.is-lit .step-dot { color: var(--color-ink-950); background: var(--color-snow); border-color: transparent; box-shadow: 0 0 24px rgb(129 140 248 / 0.6); }
</style>

<script>
  const tl = document.getElementById('timeline')!;
  const steps = [...tl.querySelectorAll<HTMLElement>('.step')];
  let ticking = false;
  const update = () => {
    ticking = false;
    const r = tl.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
    tl.style.setProperty('--p', p.toFixed(3));
    steps.forEach((s) => s.classList.toggle('is-lit', s.getBoundingClientRect().top < innerHeight * 0.6));
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();
</script>
