---
import Icon from './Icon.astro';
const { harga, kontak: site, waLink } = Astro.locals.content;
const { packages, addons } = harga;
---
<section id="harga" class="section">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow" data-reveal>Paket & harga</span>
      <h2 class="h-section" data-reveal style="--d:1">Harga transparan, <span class="text-gradient">tanpa biaya tersembunyi.</span></h2>
      <p class="lead mx-auto" data-reveal style="--d:2">Harga final ditentukan setelah konsultasi gratis, dan tertulis di proposal sebelum pekerjaan dimulai.</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {packages.map((p, i) => (
        <div class:list={['relative flex flex-col rounded-3xl p-7', p.popular ? 'ring-glow bg-gradient-to-b from-brand-600/20 to-ink-850 lg:-my-4 lg:py-11' : 'card']} data-reveal style={`--d:${i}`}>
          {p.popular && <span class="absolute -top-3 left-7 rounded-full bg-snow px-3 py-1 text-xs font-bold text-ink-950">Paling Populer</span>}
          <h3 class="text-xl font-semibold">{p.name}</h3>
          <p class="mt-1 text-sm text-mist">{p.for}</p>
          <div class="mt-6 flex items-baseline gap-2">
            {p.prefix && <span class="text-sm text-mist">{p.prefix}</span>}
            <span class="font-display text-4xl font-extrabold">{p.price}</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm">
            {p.features.map((f) => <li class="flex gap-2.5"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-aqua" /><span class="text-snow/90">{f}</span></li>)}
          </ul>
          {p.price === 'Konsultasi' && site.bookingUrl
            ? <a href={site.bookingUrl} target="_blank" rel="noopener" data-track="booking_open" class:list={['btn mt-8 w-full', p.popular ? 'btn-primary' : 'btn-ghost']}><Icon name="calendar" size={18} /> Jadwalkan konsultasi</a>
            : <a href={`#brief`} data-paket={p.name} class:list={['pick-pkg btn mt-8 w-full', p.popular ? 'btn-primary' : 'btn-ghost']}>
                {p.price === 'Konsultasi' ? 'Jadwalkan konsultasi' : `Pilih paket ${p.name}`}
              </a>}
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3 text-sm" data-reveal>
      {addons.map((a) => <span class="chip !px-4 !py-1.5"><strong class="mr-1 font-medium text-snow">{a.name}</strong> {a.price}</span>)}
    </div>
    <p class="mt-4 text-center text-sm text-mist" data-reveal>Pembayaran bertahap: DP 50%, pelunasan saat serah terima. Source code jadi milik Anda.</p>

    <!-- Kebutuhan custom -->
    <div id="custom" class="card mt-20 flex flex-col items-center gap-6 p-6 text-center sm:p-10 lg:flex-row lg:justify-between lg:text-left" data-reveal>
      <div>
        <h3 class="text-2xl font-bold sm:text-3xl">Punya kebutuhan custom?</h3>
        <p class="mt-2 max-w-xl text-mist">Ceritakan langsung lewat WhatsApp. Kami bantu hitung biaya dan waktu pengerjaannya, gratis.</p>
      </div>
      <a href={waLink('Halo Natakarsa Tech, saya punya kebutuhan sistem custom. Boleh konsultasi?')} target="_blank" rel="noopener" data-section="custom" class="btn btn-wa shrink-0"><Icon name="wa" /> Chat WhatsApp</a>
    </div>
  </div>
</section>

<script>
  // Tombol "Pilih paket" mengisi otomatis formulir brief
  document.querySelectorAll<HTMLAnchorElement>('.pick-pkg').forEach((a) => a.addEventListener('click', () => {
    const sel = document.querySelector<HTMLSelectElement>('#brief select[name=paket]');
    if (sel) sel.value = a.dataset.paket!;
    (window as any).track?.('pricing_select', { paket: a.dataset.paket });
  }));
</script>
