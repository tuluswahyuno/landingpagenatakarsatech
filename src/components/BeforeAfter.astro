---
import Icon from './Icon.astro';
import AppMockup from './AppMockup.astro';
import { problems } from '../data/site';
const notes = [
  { t: 'stok_FINAL_revisi3.xlsx', r: '-6deg', x: '6%', y: '10%' },
  { t: 'Nota #0412 — belum diinput', r: '4deg', x: '42%', y: '6%' },
  { t: 'Rekap cabang 2 (manual)', r: '-3deg', x: '18%', y: '44%' },
  { t: 'Chat: "Kak, pesanan saya mana?"', r: '5deg', x: '50%', y: '40%' },
  { t: 'Selisih stok: ???', r: '-8deg', x: '10%', y: '74%' },
  { t: 'Laporan bulan lalu belum jadi', r: '3deg', x: '46%', y: '72%' },
];
---
<section id="masalah" class="section">
  <div class="container-x">
    <div class="max-w-3xl">
      <span class="eyebrow" data-reveal>Sebelum & sesudah</span>
      <h2 class="h-section" data-reveal style="--d:1">Geser, dan lihat bisnis Anda <span class="text-gradient">tanpa kekacauan manual.</span></h2>
    </div>

    <div class="mt-12 grid items-center gap-10 lg:grid-cols-[1.25fr_1fr]">
      <div class="ba relative aspect-[4/3] overflow-hidden rounded-3xl border border-white/10 bg-ink-800 select-none sm:aspect-[16/10]" data-reveal style="--pos:50%">
        <!-- AFTER -->
        <div class="absolute inset-0 grid place-items-center bg-gradient-to-br from-brand-600/20 via-ink-850 to-cyan-500/10 p-6 sm:p-10">
          <AppMockup variant="dashboard" accent="#22d3ee" title="Dashboard otomatis" class="w-full max-w-lg" />
          <span class="absolute right-4 bottom-4 rounded-full bg-emerald-400/15 px-3 py-1 text-xs font-semibold text-emerald-300">Sesudah</span>
        </div>
        <!-- BEFORE -->
        <div class="ba-before absolute inset-0 bg-[#1a1714]" aria-hidden="true">
          <div class="absolute inset-0 opacity-30" style="background-image:repeating-linear-gradient(0deg,transparent 0 23px,rgb(255 255 255 / .06) 23px 24px)"></div>
          {notes.map((n) => (
            <div class="absolute max-w-[46%] rounded-md bg-amber-100 px-3 py-2 font-mono text-[11px] text-stone-800 shadow-lg sm:text-xs" style={`left:${n.x};top:${n.y};rotate:${n.r}`}>{n.t}</div>
          ))}
          <span class="absolute bottom-4 left-4 rounded-full bg-red-400/15 px-3 py-1 text-xs font-semibold text-red-300">Sebelum</span>
        </div>
        <div class="ba-handle pointer-events-none absolute inset-y-0 w-0.5 bg-white/80" aria-hidden="true">
          <span class="absolute top-1/2 left-1/2 grid h-11 w-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-ink-950 shadow-xl">
            <Icon name="arrow-left" size={14} /><Icon name="arrow" size={14} class="-ml-1" />
          </span>
        </div>
        <input type="range" min="0" max="100" value="50" class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" aria-label="Geser untuk membandingkan sebelum dan sesudah" />
      </div>

      <ul class="space-y-4">
        {problems.map((p, i) => (
          <li class="card p-5" data-reveal style={`--d:${i}`}>
            <p class="flex items-start gap-2 text-sm text-mist line-through decoration-red-400/50"><Icon name="x" size={16} class="mt-0.5 shrink-0 text-red-400" />{p.before}</p>
            <p class="mt-2 flex items-start gap-2 font-medium text-snow"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-emerald-400" />{p.after}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-handle { left: var(--pos); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((ba) => {
    const r = ba.querySelector<HTMLInputElement>('.ba-range')!;
    const set = () => ba.style.setProperty('--pos', r.value + '%');
    r.addEventListener('input', set);
    // Animasi pembuka: geser otomatis sekali saat pertama terlihat
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - start) / 1800);
          const v = 50 + Math.sin(k * Math.PI * 2) * 30 * (1 - k);
          r.value = String(v); set();
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }, { threshold: 0.6 });
      io.observe(ba);
    }
  });
</script>
