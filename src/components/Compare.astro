---
import Icon from './Icon.astro';
import { comparison } from '../data/site';
const icon = { yes: ['check', 'text-emerald-400', 'Ya'], partial: ['minus', 'text-amber-300', 'Sebagian'], no: ['x', 'text-red-400/80', 'Tidak'] } as const;
---
<section id="kenapa" class="section">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow" data-reveal>Kenapa Natakarsa Tech</span>
      <h2 class="h-section" data-reveal style="--d:1">Sistem custom, <span class="text-gradient">dukungan seperti tim sendiri.</span></h2>
    </div>
    <div class="card mx-auto mt-12 max-w-4xl overflow-x-auto" data-reveal>
      <table class="w-full min-w-[560px] text-sm">
        <thead>
          <tr class="border-b border-white/5">
            <th class="p-5 text-left font-medium text-mist"><span class="sr-only">Aspek</span></th>
            {comparison.cols.map((c, i) => <th scope="col" class:list={['p-5 text-center font-semibold', i === 0 ? 'text-snow' : 'text-mist']}>{i === 0 ? <span class="text-gradient">{c}</span> : c}</th>)}
          </tr>
        </thead>
        <tbody>
          {comparison.rows.map((r) => (
            <tr class="border-b border-white/5 last:border-0">
              <th scope="row" class="p-5 text-left font-normal text-snow/90">{r.label}</th>
              {r.v.map((v, i) => (
                <td class:list={['p-5 text-center', i === 0 ? 'bg-brand-500/[0.07]' : '']}>
                  <Icon name={icon[v as keyof typeof icon][0]} size={20} class={`inline ${icon[v as keyof typeof icon][1]}`} />
                  <span class="sr-only">{icon[v as keyof typeof icon][2]}</span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
