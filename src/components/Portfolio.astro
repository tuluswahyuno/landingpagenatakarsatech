---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import AppMockup from './AppMockup.astro';
import { categories } from '../data/site';
const items = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
---
<section id="portofolio" class="section">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <span class="eyebrow" data-reveal>Portofolio</span>
        <h2 class="h-section" data-reveal style="--d:1">Sistem nyata yang <span class="text-gradient">dipakai setiap hari.</span></h2>
        <p class="lead" data-reveal style="--d:2">Setiap aplikasi lahir dari masalah bisnis yang nyata. Pilih yang mirip dengan usaha Anda.</p>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter kategori" data-reveal style="--d:3">
        {categories.map((c, i) => (
          <button type="button" class:list={['filter-btn rounded-full border px-4 py-2 text-sm transition', i === 0 ? 'is-active' : '']} data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>
        ))}
      </div>
    </div>

    <div id="portfolio-grid" class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {items.map((p, i) => (
        <a href={`/portofolio/${p.id}/`} class="pf-card tilt-card group card relative flex flex-col overflow-hidden transition hover:border-white/20" data-category={p.data.category} data-reveal style={`--d:${i % 3}`}>
          <div class="tilt-glow pointer-events-none absolute inset-0 z-10 opacity-0 transition group-hover:opacity-100"></div>
          <div class="relative h-56 overflow-hidden p-5" style={`background:radial-gradient(120% 90% at 30% 0%, ${p.data.accent}33, transparent 60%), #0d0d14`}>
            <div class="transition duration-700 ease-out group-hover:-translate-y-2 group-hover:scale-[1.03]" style={`view-transition-name: pf-${p.id}`}>
              {p.data.images[0]
                ? <img src={p.data.images[0]} alt={`Tampilan ${p.data.title}`} loading="lazy" decoding="async" width="640" height="400" class="rounded-xl border border-white/10" />
                : p.data.mockup === 'mobile'
                  ? <AppMockup variant="mobile" accent={p.data.accent} title={p.data.title} class="origin-top scale-[0.78]" />
                  : <AppMockup variant={p.data.mockup} accent={p.data.accent} title={p.data.title} />}
            </div>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center gap-2 text-xs text-mist">
              <span>{p.data.industry}</span><span>·</span><span>{p.data.year}</span>
              {p.data.contoh && <span class="badge-contoh ml-auto" title="Data contoh, akan diganti portofolio asli">Contoh</span>}
            </div>
            <h3 class="mt-2 text-xl font-semibold">{p.data.title}</h3>
            <p class="mt-2 text-sm text-mist">{p.data.summary}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">{p.data.tags.map((t) => <span class="chip">{t}</span>)}</div>
            <div class="mt-auto flex items-center justify-between pt-6">
              <span class="text-sm font-semibold" style={`color:${p.data.accent}`}>{p.data.result}</span>
              <span class="grid h-9 w-9 place-items-center rounded-full border border-white/10 transition group-hover:border-white/30 group-hover:bg-white/5"><Icon name="arrow" size={16} /></span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <p id="pf-empty" class="mt-10 hidden text-center text-mist">Belum ada contoh di kategori ini. <a href="#brief" class="text-brand-300 underline">Ceritakan kebutuhan Anda</a> — kami tetap bisa membangunnya.</p>
  </div>
</section>

<style>
  .filter-btn { border-color: rgb(255 255 255 / 0.1); color: var(--color-mist); }
  .filter-btn:hover { color: var(--color-snow); border-color: rgb(255 255 255 / 0.25); }
  .filter-btn.is-active { background: var(--color-snow); color: var(--color-ink-950); border-color: var(--color-snow); }
  .pf-card.is-hidden { display: none; }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.pf-card');
  const empty = document.getElementById('pf-empty')!;
  const apply = (cat: string, push = true) => {
    const run = () => {
      let shown = 0;
      cards.forEach((c) => { const on = cat === 'semua' || c.dataset.category === cat; c.classList.toggle('is-hidden', !on); if (on) { shown++; c.classList.add('is-in'); } });
      empty.classList.toggle('hidden', shown > 0);
      btns.forEach((b) => { const a = b.dataset.filter === cat; b.classList.toggle('is-active', a); b.setAttribute('aria-pressed', String(a)); });
    };
    const d = document as any;
    if (d.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.startViewTransition(run); else run();
    if (push) {
      const u = new URL(location.href);
      cat === 'semua' ? u.searchParams.delete('kategori') : u.searchParams.set('kategori', cat);
      history.replaceState(null, '', u);
      (window as any).track?.('portfolio_filter', { kategori: cat });
    }
  };
  btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  const initial = new URLSearchParams(location.search).get('kategori');
  if (initial && [...btns].some((b) => b.dataset.filter === initial)) apply(initial, false);

  // Tilt 3D + glow mengikuti kursor (desktop saja)
  if (matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.tilt-card').forEach((el) => {
      el.classList.add('tilt');
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        el.style.setProperty('--ry', `${(x - 0.5) * 8}deg`);
        el.style.setProperty('--rx', `${(0.5 - y) * 8}deg`);
        el.style.setProperty('--gx', `${x * 100}%`);
        el.style.setProperty('--gy', `${y * 100}%`);
      });
      el.addEventListener('pointerleave', () => { el.style.setProperty('--rx', '0deg'); el.style.setProperty('--ry', '0deg'); });
    });
  }
</script>
