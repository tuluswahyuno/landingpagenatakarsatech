---
import Icon from './Icon.astro';
import { services } from '../data/site';
---
<section id="layanan" class="section">
  <div class="container-x">
    <div class="max-w-3xl">
      <span class="eyebrow" data-reveal>Layanan</span>
      <h2 class="h-section" data-reveal style="--d:1">Satu tim untuk semua kebutuhan <span class="text-gradient">digital bisnis Anda.</span></h2>
      <p class="lead" data-reveal style="--d:2">Pilih yang paling mendesak dulu. Sistem bisa berkembang bertahap seiring bisnis Anda tumbuh.</p>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <a href={s.category === 'semua' ? '#portofolio' : `/?kategori=${s.category}#portofolio`} class="tilt-card group card relative overflow-hidden p-6 transition hover:border-white/20" data-reveal style={`--d:${i}`}>
          <div class="tilt-glow pointer-events-none absolute inset-0 opacity-0 transition group-hover:opacity-100"></div>
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-brand-500/30 to-cyan-400/10 text-brand-300 ring-1 ring-white/10 transition duration-500 group-hover:scale-110 group-hover:rotate-6">
            <Icon name={s.icon} size={24} />
          </span>
          <h3 class="mt-5 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm text-mist">{s.desc}</p>
          <div class="mt-6 flex items-center justify-between border-t border-white/5 pt-4 text-sm">
            <span class="text-mist">{s.from === 'Konsultasi' ? 'Harga via konsultasi' : <>Mulai <strong class="text-snow">{s.from}</strong></>}</span>
            <Icon name="arrow" size={18} class="text-mist transition group-hover:translate-x-1 group-hover:text-snow" />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
