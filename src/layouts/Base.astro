---
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
// Font utama di-preload agar teks tidak berganti ukuran saat font selesai dimuat (mencegah CLS)
import jakartaUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWA from '../components/FloatingWA.astro';
import CompanyProfile from '../components/CompanyProfile.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: Record<string, unknown>[];
  faqSchema?: boolean;
}
const { title = site.title, description = site.description, image = '/og.png', schema = [], faqSchema = false } = Astro.props;
const { kontak, faq } = Astro.locals.content;
const faqs = faq.items;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: kontak.email,
  logo: new URL('/favicon.svg', site.url).href,
  sameAs: kontak.socials.map((s) => s.href),
};
const faqLd = faqSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
const ld = [org, ...(faqLd ? [faqLd] : []), ...schema];
---
<!doctype html>
<html lang="id" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={jakartaUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0a0f" id="meta-theme" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Pasang tema sebelum halaman tampil (mencegah kilatan warna)
      (function () {
        var d = document.documentElement, t;
        d.classList.remove('no-js');
        try { t = localStorage.getItem('nk_theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.dataset.theme = t;
        var m = document.getElementById('meta-theme');
        if (m) m.setAttribute('content', t === 'light' ? '#f7f8fb' : '#0a0a0f');
      })();
    </script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <slot name="head" />
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2">Lewati ke konten</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingWA />
    <CompanyProfile />
    <Analytics />

    <script>
      // ---- Analytics helper: satu fungsi, diteruskan ke semua alat yang terpasang ----
      const w = window as any;
      w.dataLayer = w.dataLayer || [];
      // Event konversi standar Meta Pixel
      const pixelStd: Record<string, string> = { lead_submit: 'Lead', cta_whatsapp_click: 'Contact', booking_open: 'Schedule', profile_download: 'Lead' };
      w.track = (event: string, params: Record<string, unknown> = {}) => {
        try {
          if (typeof w.gtag === 'function') w.gtag('event', event, params);
          else w.dataLayer.push({ event, ...params });
          if (typeof w.umami?.track === 'function') w.umami.track(event, params);
          if (typeof w.clarity === 'function') w.clarity('event', event);
          if (typeof w.fbq === 'function') pixelStd[event] ? w.fbq('track', pixelStd[event], params) : w.fbq('trackCustom', event, params);
        } catch {}
      };
      // Elemen dengan data-track="nama_event" otomatis tercatat saat diklik
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (el) w.track(el.dataset.track!, { section: el.closest('section')?.id || 'global' });
      });

      // ---- Simpan UTM kunjungan pertama ----
      try {
        const p = new URLSearchParams(location.search);
        const utm: Record<string, string> = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((k) => { const v = p.get(k); if (v) utm[k] = v; });
        if (Object.keys(utm).length && !localStorage.getItem('nk_utm')) localStorage.setItem('nk_utm', JSON.stringify(utm));
      } catch {}

      // ---- Reveal on scroll ----
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      // Elemen yang sudah terlihat saat halaman dibuka langsung ditampilkan.
      // Semua posisi dibaca dulu, baru class diubah: membaca posisi di sela perubahan class
      // memaksa browser menghitung ulang layout berkali-kali (layout thrashing).
      const revealEls = [...document.querySelectorAll('[data-reveal]')];
      const inView = revealEls.map((el) => el.getBoundingClientRect().top < innerHeight);
      revealEls.forEach((el, i) => (inView[i] ? el.classList.add('is-in') : io.observe(el)));

      // ---- Ganti tema terang / gelap ----
      const root = document.documentElement;
      const meta = document.getElementById('meta-theme');
      const applyTheme = (t: 'light' | 'dark', animate = true) => {
        if (animate) { root.classList.add('theme-anim'); setTimeout(() => root.classList.remove('theme-anim'), 400); }
        root.dataset.theme = t;
        meta?.setAttribute('content', t === 'light' ? '#f7f8fb' : '#0a0a0f');
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
          b.setAttribute('aria-label', t === 'light' ? 'Ganti ke mode gelap' : 'Ganti ke mode terang');
          b.setAttribute('aria-pressed', String(t === 'light'));
        });
      };
      applyTheme((root.dataset.theme as 'light' | 'dark') || 'dark', false);
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
        if (!btn) return;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        applyTheme(next);
        try { localStorage.setItem('nk_theme', next); } catch {}
        w.track('theme_toggle', { theme: next });
      });
      // Ikuti perubahan tema sistem selama pengunjung belum memilih sendiri
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
        let saved = null;
        try { saved = localStorage.getItem('nk_theme'); } catch {}
        if (!saved) applyTheme(e.matches ? 'light' : 'dark');
      });

      // ---- Klik semua link WhatsApp tercatat ----
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a[href^="https://wa.me"]') as HTMLAnchorElement | null;
        if (a) w.track('cta_whatsapp_click', { section: a.dataset.section || a.closest('section')?.id || 'global' });
      });

      // ---- Scroll depth ----
      const marks = [25, 50, 75, 100];
      const hit = new Set<number>();
      addEventListener('scroll', () => {
        const pct = ((scrollY + innerHeight) / document.documentElement.scrollHeight) * 100;
        marks.forEach((m) => { if (pct >= m && !hit.has(m)) { hit.add(m); w.track('scroll_depth', { percent: m }); } });
      }, { passive: true });
    </script>
  </body>
</html>
