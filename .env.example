# Salin file ini menjadi .env lalu isi. File .env jangan di-commit.

# ---- Wajib ----
# Alamat & port aplikasi. Di CloudPanel, samakan PORT dengan "App Port" situs.
HOST=127.0.0.1
PORT=4321
# Database MySQL / MariaDB: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=mysql://natakarsa:GANTI_PASSWORD@127.0.0.1:3306/natakarsa
# true bila berjalan di belakang Nginx (agar IP pengunjung & HTTPS terbaca benar)
TRUST_PROXY=true
# Folder penyimpanan file upload dari panel admin
UPLOAD_DIR=./uploads

# ---- Notifikasi lead (opsional, disarankan) ----
# Telegram: buat bot di @BotFather, lalu ambil chat id (lihat README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email: alamat penerima notifikasi + akun SMTP pengirim
# Contoh Gmail (pakai App Password): smtps://emailanda%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
ADMIN_EMAIL=
SMTP_URL=
SMTP_FROM="Natakarsa Tech <halo@natakarsa.com>"
# WhatsApp otomatis lewat Fonnte (balasan di luar jam kerja & pengingat follow-up)
FONNTE_TOKEN=

# ---- Anti-spam Cloudflare Turnstile (opsional, disarankan) ----
PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ---- Analytics (opsional) ----
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_META_PIXEL_ID=
